# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | google
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o              # optional override (default: gpt-4o)

# ── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-1.5-pro

# ── API (Frontend → Backend) ──────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── PostgreSQL (Docker Compose `db` service) ───────────────────────────────────
# Use only [A-Za-z0-9_.-] in passwords so DATABASE_URL stays valid.
POSTGRES_DB=dyzart
POSTGRES_USER=dyzart_app
POSTGRES_PASSWORD=change-me-StrongDbPass-1

# Optional: read-only login for Rocket Admin / DBeaver (SELECT only on public)
POSTGRES_READONLY_USER=dyzart_ro
POSTGRES_READONLY_PASSWORD=change-me-ReadOnly-2

# ── Database URL (local backend without Docker) ───────────────────────────────
# Must match POSTGRES_* above when DB runs in Docker with port 5432 published.
DATABASE_URL=postgresql://dyzart_app:change-me-StrongDbPass-1@localhost:5432/dyzart

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
