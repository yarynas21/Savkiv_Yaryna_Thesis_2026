# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | google
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o              # optional override (default: gpt-4o)

# ── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-1.5-pro
